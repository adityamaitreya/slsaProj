# Environment configuration for SLSA Demo App
# Copy this to .env and customize for your environment

# Flask configuration
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# Application configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security (will be used in later stages)
SECRET_KEY=your-secret-key-here-change-this

# Database connection (for later stages)
DATABASE_URL=postgresql://user:password@localhost:5432/slsa_demo

# Note: Never commit the actual .env file with real secrets!